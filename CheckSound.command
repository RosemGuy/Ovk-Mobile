#!/bin/bash
set -eu
cd "$(dirname "$0")"
echo 'Проверка звука самой macOS, без приложения и симулятора.'
echo 'Сейчас должен прозвучать ровный тон длительностью 2 секунды.'
if ! command -v afplay >/dev/null 2>&1; then
    echo 'Запусти этот файл в OS X внутри виртуальной машины.' >&2; exit 1
fi
afplay OpenVK/DemoAudio.wav
echo 'Тест завершён. Если тон зациклился, оборвался или застрял — проверь аудиоустройство виртуалки.'
echo 'Если тон прошёл нормально, это ещё не исключает отдельную проблему симулятора.'
